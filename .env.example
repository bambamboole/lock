APP_NAME="Lock"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lock.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Set to true in local development to auto-write missing translation keys to lang/.
I18NEXT_SAVE_MISSING=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

REALM_MASTER_SLUG=master
REALM_DEFAULT_SLUG=default

OIDC_ISSUER=${APP_URL}
OIDC_FIRST_PARTY_CLIENT=
OIDC_FIRST_PARTY_TRUSTED=true

OIDC_RP_ENABLED=true
OIDC_RP_ISSUER=${APP_URL}/realms/default
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_RP_POST_LOGOUT_REDIRECT_URI=${APP_URL}

OIDC_PRIVATE_KEY=
OIDC_PUBLIC_KEY=
OIDC_PREVIOUS_PUBLIC_KEY=
