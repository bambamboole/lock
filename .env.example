APP_NAME="Lock"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lock.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Set to true in local development to auto-write missing translation keys to lang/.
I18NEXT_SAVE_MISSING=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

REALM_MASTER_SLUG=admin

OIDC_ISSUER=${APP_URL}

# The console's own OIDC client. Set both the id and the secret and every
# deploy provisions (or re-provisions) exactly that client; leave the secret
# empty and the client is left alone. `oidc:install-self` fills them in for a
# local setup.
OIDC_FIRST_PARTY_CLIENT=
OIDC_FIRST_PARTY_SECRET=
OIDC_FIRST_PARTY_TRUSTED=true

# The console is its own relying party, so these default to the first-party
# credentials above. Set them only to sign in against a different provider.
OIDC_RP_ENABLED=true
OIDC_RP_ISSUER=${APP_URL}
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_RP_POST_LOGOUT_REDIRECT_URI=${APP_URL}

# The first administrator, reconciled into the master realm on every deploy.
# An address alone creates and promotes the user; a password is re-applied on
# every deploy, so a password changed in the console is overwritten.
LOCK_ADMIN_EMAIL=
LOCK_ADMIN_PASSWORD=
LOCK_ADMIN_NAME="Administrator"
