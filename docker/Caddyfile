{
	frankenphp
	admin off
	auto_https off
}

# Plain HTTP on an unprivileged port. TLS terminates at the platform proxy
# (Coolify's Traefik, a load balancer); the app trusts its forwarded headers
# via trustProxies() in bootstrap/app.php.
:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	log {
		output stderr
		format json
	}

	php_server
}
